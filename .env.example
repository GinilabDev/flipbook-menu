# Copy to .env.local and adjust. Both values default to the local Laragon
# setup, so development works without this file.

# tomafood admin API base — the flipbook's /api/flipbook/* routes proxy here.
# Server-side only; never reaches the browser.
ADMIN_API_BASE=http://localhost/tomafood-net/api/v2

# Web root that admin media paths (logos, recipe images) are relative to.
# NEXT_PUBLIC_ because item thumbnails and the header logo are rendered in the
# browser. In production this MUST be https, or the images are blocked as mixed
# content on an https page.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost/tomafood-net

# --- production example ---
# ADMIN_API_BASE=https://admin.tomafood.net/api/v2
# NEXT_PUBLIC_MEDIA_BASE_URL=https://admin.tomafood.net
